+// Copyright 2026 The Iltix Authors. All rights reserved.
+// Use of this source code is governed by a GPL-2.0-or-later license.
+
+package org.chromium.chrome.browser.iltix.settings;
+
+import android.content.Context;
+import android.util.AttributeSet;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.preference.SwitchPreferenceCompat;
+
+import org.chromium.chrome.browser.iltix.IltixModuleManager;
+
+/**
+ * A SwitchPreferenceCompat that automatically syncs its state to/from
+ * {@link IltixModuleManager}.
+ *
+ * Set {@code android:key} to one of the {@code IltixModuleManager.MODULE_*}
+ * constants in the preference XML. No additional Java wiring is needed.
+ */
+public class IltixModulePreference extends SwitchPreferenceCompat {
+    public IltixModulePreference(@NonNull Context ctx, @Nullable AttributeSet attrs,
+            int defStyle, int defStyleRes) {
+        super(ctx, attrs, defStyle, defStyleRes);
+        init();
+    }
+
+    public IltixModulePreference(@NonNull Context ctx, @Nullable AttributeSet attrs,
+            int defStyle) {
+        super(ctx, attrs, defStyle);
+        init();
+    }
+
+    public IltixModulePreference(@NonNull Context ctx, @Nullable AttributeSet attrs) {
+        super(ctx, attrs);
+        init();
+    }
+
+    private void init() {
+        setPersistent(false); // We manage persistence ourselves via IltixModuleManager
+        setChecked(IltixModuleManager.get().isEnabled(getKey() != null ? getKey() : ""));
+        setOnPreferenceChangeListener((pref, newVal) -> {
+            IltixModuleManager.get().setEnabled(pref.getKey(), (Boolean) newVal);
+            return true;
+        });
+    }
+}
