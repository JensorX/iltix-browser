+// Copyright 2026 The Iltix Authors. All rights reserved.
+// Use of this source code is governed by a GPL-2.0-or-later license.
+
+package org.chromium.chrome.browser.iltix.settings;
+
+import android.os.Bundle;
+
+import androidx.annotation.Nullable;
+import androidx.preference.PreferenceFragmentCompat;
+
+import org.chromium.chrome.browser.iltix.IltixModuleManager;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+
+/**
+ * Settings fragment for "Iltix Module" — lists all toggleable Iltix features.
+ *
+ * Each preference in iltix_module_preferences.xml has its key set to one of
+ * the IltixModuleManager.MODULE_* constants so that IltixModulePreference
+ * can automatically route reads/writes through IltixModuleManager.
+ */
+public class IltixModuleSettingsFragment extends PreferenceFragmentCompat {
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        SettingsUtils.addPreferencesFromResource(this, R.xml.iltix_module_preferences);
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        // Refresh all preference states in case they changed while the screen was in background.
+        refreshAllPreferences();
+    }
+
+    private void refreshAllPreferences() {
+        refreshPref(IltixModuleManager.MODULE_THEME);
+        refreshPref(IltixModuleManager.MODULE_NAVIGATION);
+        refreshPref(IltixModuleManager.MODULE_AUTOHIDE);
+    }
+
+    private void refreshPref(String key) {
+        IltixModulePreference pref = findPreference(key);
+        if (pref != null) {
+            pref.setChecked(IltixModuleManager.get().isEnabled(key));
+        }
+    }
+}
