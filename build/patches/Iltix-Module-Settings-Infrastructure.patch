+// Copyright 2026 The Iltix Authors. All rights reserved.
+// Use of this source code is governed by a GPL-2.0-or-later license.
+
+package org.chromium.chrome.browser.iltix;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import androidx.annotation.NonNull;
+
+/**
+ * Singleton that manages the enabled/disabled state of all Iltix modules.
+ *
+ * State is persisted in SharedPreferences so it survives app restarts.
+ * All modules default to ENABLED.
+ *
+ * Module keys are defined as public constants here so all referencing code
+ * uses a single source of truth.
+ */
+public class IltixModuleManager {
+    // -------------------------------------------------------------------------
+    // Module keys — add new modules here
+    // -------------------------------------------------------------------------
+    public static final String MODULE_THEME        = "iltix_module_theme";
+    public static final String MODULE_NAVIGATION   = "iltix_module_navigation";
+    public static final String MODULE_AUTOHIDE     = "iltix_module_autohide";
+
+    private static final String PREFS_NAME = "iltix_modules";
+
+    private static IltixModuleManager sInstance;
+    private final SharedPreferences mPrefs;
+
+    private IltixModuleManager(@NonNull Context context) {
+        mPrefs = context.getApplicationContext()
+                        .getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
+    }
+
+    /**
+     * Initialises the singleton. Must be called once from Application#onCreate
+     * before any module checks are performed.
+     */
+    public static synchronized void init(@NonNull Context context) {
+        if (sInstance == null) {
+            sInstance = new IltixModuleManager(context);
+        }
+    }
+
+    /**
+     * Returns the singleton. Crashes if {@link #init} has not been called.
+     */
+    public static synchronized IltixModuleManager get() {
+        if (sInstance == null) {
+            throw new IllegalStateException("IltixModuleManager.init() must be called first");
+        }
+        return sInstance;
+    }
+
+    /**
+     * Returns true if the given module is enabled.
+     * Defaults to true (all modules enabled out of the box).
+     */
+    public boolean isEnabled(@NonNull String moduleKey) {
+        return mPrefs.getBoolean(moduleKey, true);
+    }
+
+    /**
+     * Enables or disables a module. Changes take effect after an app restart
+     * for most modules (UI initialised at startup).
+     */
+    public void setEnabled(@NonNull String moduleKey, boolean enabled) {
+        mPrefs.edit().putBoolean(moduleKey, enabled).apply();
+    }
+
+    // -------------------------------------------------------------------------
+    // Convenience static helpers — use these in module code
+    // -------------------------------------------------------------------------
+
+    /** Returns true if the Iltix Theme module is currently enabled. */
+    public static boolean isThemeEnabled() {
+        return sInstance != null && sInstance.isEnabled(MODULE_THEME);
+    }
+
+    /** Returns true if the Iltix Navigation module is currently enabled. */
+    public static boolean isNavigationEnabled() {
+        return sInstance != null && sInstance.isEnabled(MODULE_NAVIGATION);
+    }
+
+    /** Returns true if the Auto-Hide Navigation module is currently enabled. */
+    public static boolean isAutoHideEnabled() {
+        return sInstance != null && sInstance.isEnabled(MODULE_AUTOHIDE);
+    }
+}
