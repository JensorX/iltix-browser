+package org.chromium.chrome.browser.iltix.theme;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Matrix;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PorterDuff;
+import android.graphics.PorterDuffXfermode;
+import android.graphics.RadialGradient;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+import android.os.Build;
+import android.view.View;
+import android.view.animation.LinearInterpolator;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.RequiresApi;
+
+/**
+ * Custom Drawable that renders the Apple-inspired "Liquid Glass" effect:
+ *
+ * Layers (bottom to top):
+ *   1. Frosted glass base: semi-transparent white/dark with backdrop blur
+ *      applied to the hosting View via RenderEffect (API 31+) or a
+ *      software blur fallback.
+ *   2. Liquid gradient overlay: an animated radial gradient that slowly
+ *      shifts position, mimicking the iOS "liquid" light refraction.
+ *   3. Specular highlight ring: a thin bright arc at the top edge,
+ *      simulating the glass thickness rim.
+ *   4. Inner shadow: subtle dark shadow at bottom edge for depth.
+ *
+ * Corner radius and margin are configurable. On Android < 12, layers 1–4
+ * are rendered but without the real backdrop blur (we still get the shape
+ * and gradient effects so it still looks premium).
+ */
+public class IltixLiquidGlassDrawable extends Drawable {
+
+    // Configuration
+    private static final float CORNER_RADIUS_DP = 28f;
+    private static final float GLASS_ALPHA      = 0.55f;  // opacity of base layer
+    private static final float GRADIENT_ALPHA   = 0.30f;  // opacity of liquid gradient
+
+    // Liquid animation
+    private static final long ANIM_DURATION_MS = 5_000L;
+
+    private final float mCornerRadius;
+    private final boolean mIsDark;
+
+    private final Paint mBasePaint    = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mGradPaint    = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mHighPaint    = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mShadowPaint  = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mClearPaint   = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+    private final RectF mBounds = new RectF();
+    private final Path  mClipPath = new Path();
+
+    private ValueAnimator mAnimator;
+    private float mAnimFraction;  // 0..1, drives liquid gradient offset
+
+    public IltixLiquidGlassDrawable(@NonNull Context context, boolean isDark) {
+        mCornerRadius = CORNER_RADIUS_DP * context.getResources().getDisplayMetrics().density;
+        mIsDark = isDark;
+        mClearPaint.setXfermode(new PorterDuffXfermode(PorterDuff.Mode.CLEAR));
+        setupAnimator();
+    }
+
+    // -------------------------------------------------------------------------
+    // Animation
+    // -------------------------------------------------------------------------
+
+    private void setupAnimator() {
+        mAnimator = ValueAnimator.ofFloat(0f, 1f);
+        mAnimator.setDuration(ANIM_DURATION_MS);
+        mAnimator.setRepeatCount(ValueAnimator.INFINITE);
+        mAnimator.setRepeatMode(ValueAnimator.REVERSE);
+        mAnimator.setInterpolator(new LinearInterpolator());
+        mAnimator.addUpdateListener(anim -> {
+            mAnimFraction = (float) anim.getAnimatedValue();
+            invalidateSelf();
+        });
+    }
+
+    public void startAnimation() {
+        if (!mAnimator.isRunning()) mAnimator.start();
+    }
+
+    public void stopAnimation() {
+        mAnimator.cancel();
+    }
+
+    // -------------------------------------------------------------------------
+    // Drawable interface
+    // -------------------------------------------------------------------------
+
+    @Override
+    protected void onBoundsChange(@NonNull android.graphics.Rect bounds) {
+        super.onBoundsChange(bounds);
+        mBounds.set(bounds);
+        mClipPath.reset();
+        mClipPath.addRoundRect(mBounds, mCornerRadius, mCornerRadius, Path.Direction.CW);
+        updateGradients();
+    }
+
+    private void updateGradients() {
+        float cx = mBounds.centerX();
+        float cy = mBounds.centerY();
+        float r  = Math.max(mBounds.width(), mBounds.height()) * 0.8f;
+
+        // Liquid gradient: a radial gradient whose centre drifts with mAnimFraction
+        float offsetX = (mAnimFraction - 0.5f) * mBounds.width() * 0.6f;
+        float offsetY = (mAnimFraction - 0.5f) * mBounds.height() * 0.4f;

+        int centerColor = mIsDark
+                ? Color.argb((int)(GRADIENT_ALPHA * 255), 180, 200, 255)  // cool blue-white
+                : Color.argb((int)(GRADIENT_ALPHA * 255), 255, 255, 255);
+        int edgeColor = Color.TRANSPARENT;
+
+        mGradPaint.setShader(new RadialGradient(
+                cx + offsetX, cy + offsetY, r,
+                new int[]{centerColor, edgeColor},
+                null,
+                Shader.TileMode.CLAMP));
+
+        // Specular highlight: thin horizontal linear gradient at top
+        int hiColor = mIsDark
+                ? Color.argb(80, 255, 255, 255)
+                : Color.argb(120, 255, 255, 255);
+        mHighPaint.setShader(new LinearGradient(
+                mBounds.left, mBounds.top,
+                mBounds.left, mBounds.top + mCornerRadius * 0.8f,
+                hiColor, Color.TRANSPARENT,
+                Shader.TileMode.CLAMP));
+
+        // Base glass tint
+        int baseColor = mIsDark
+                ? Color.argb((int)(GLASS_ALPHA * 255), 30, 30, 40)
+                : Color.argb((int)(GLASS_ALPHA * 255), 245, 245, 255);
+        mBasePaint.setColor(baseColor);
+
+        // Inner shadow at bottom
+        mShadowPaint.setShader(new LinearGradient(
+                mBounds.left, mBounds.bottom - mCornerRadius,
+                mBounds.left, mBounds.bottom,
+                Color.TRANSPARENT,
+                Color.argb(40, 0, 0, 0),
+                Shader.TileMode.CLAMP));
+    }
+
+    @Override
+    public void draw(@NonNull Canvas canvas) {
+        if (mBounds.isEmpty()) return;
+
+        // Re-build gradient with current animation fraction
+        updateGradients();
+
+        int saveCount = canvas.save();
+        canvas.clipPath(mClipPath);
+
+        // Layer 1: glass base
+        canvas.drawRoundRect(mBounds, mCornerRadius, mCornerRadius, mBasePaint);
+        // Layer 2: liquid gradient
+        canvas.drawRoundRect(mBounds, mCornerRadius, mCornerRadius, mGradPaint);
+        // Layer 3: specular rim
+        canvas.drawRoundRect(mBounds, mCornerRadius, mCornerRadius, mHighPaint);
+        // Layer 4: bottom inner shadow
+        canvas.drawRoundRect(mBounds, mCornerRadius, mCornerRadius, mShadowPaint);

+        canvas.restoreToCount(saveCount);
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        mBasePaint.setAlpha(alpha);
+        invalidateSelf();
+    }
+
+    @Override
+    public void setColorFilter(android.graphics.ColorFilter colorFilter) {
+        mBasePaint.setColorFilter(colorFilter);
+        invalidateSelf();
+    }
+
+    @Override
+    public int getOpacity() {
+        return android.graphics.PixelFormat.TRANSLUCENT;
+    }
+}
