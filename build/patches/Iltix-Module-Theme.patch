+// Copyright 2026 The Iltix Authors. All rights reserved.
+// Use of this source code is governed by a GPL-2.0-or-later license.
+
+package org.chromium.chrome.browser.iltix.theme;
+
+import android.app.Activity;
+import android.graphics.Color;
+import android.os.Build;
+import android.renderscript.RenderScript;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.view.WindowInsets;
+import android.view.WindowInsetsController;
+import android.view.WindowManager;
+
+import androidx.annotation.NonNull;
+import androidx.core.view.WindowCompat;
+import androidx.core.view.WindowInsetsControllerCompat;
+
+import org.chromium.chrome.browser.iltix.IltixModuleManager;
+
+/**
+ * Applies the Iltix Theme module:
+ *
+ *  1. Transparent system bars (status bar + navigation bar)
+ *  2. Edge-to-edge layout (draws behind system bars)
+ *  3. Liquid Glass background on the passed view (typically the bottom toolbar)
+ *  4. Floating margin + rounded corners on the nav bar container
+ *
+ * Call {@link #applyWindowTheme(Activity)} early in Activity.onCreate.
+ * Call {@link #applyNavBarGlass(View, boolean)} once the bottom controls view is inflated.
+ */
+public class IltixThemeModule {
+
+    private static final float FLOATING_MARGIN_DP   = 10f;
+    private static final float NAV_BOTTOM_MARGIN_DP = 10f;
+
+    /**
+     * Makes the Activity window edge-to-edge with fully transparent system bars.
+     * Must be called before setContentView or very early in onCreate.
+     * No-op if Iltix Theme module is disabled.
+     */
+    public static void applyWindowTheme(@NonNull Activity activity) {
+        if (!IltixModuleManager.isThemeEnabled()) return;
+
+        // Edge-to-edge: let content draw behind system bars
+        WindowCompat.setDecorFitsSystemWindows(activity.getWindow(), false);

+        // Fully transparent status bar and navigation bar
+        Window window = activity.getWindow();
+        window.setStatusBarColor(Color.TRANSPARENT);
+        window.setNavigationBarColor(Color.TRANSPARENT);

+        // On Android 29+ we can also clear the navigation bar divider
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+            window.setNavigationBarDividerColor(Color.TRANSPARENT);
+        }

+        // Light/dark icons on status/nav bar depending on day/night mode
+        WindowInsetsControllerCompat controller =
+                WindowCompat.getInsetsController(window, window.getDecorView());
+        boolean isNight = (activity.getResources().getConfiguration().uiMode
+                & android.content.res.Configuration.UI_MODE_NIGHT_MASK)
+                == android.content.res.Configuration.UI_MODE_NIGHT_YES;
+        controller.setAppearanceLightStatusBars(!isNight);
+        controller.setAppearanceLightNavigationBars(!isNight);
+    }

+    /**
+     * Applies the Liquid Glass drawable as the background of {@code navBarView}
+     * and adds floating margins so the bar appears to float above the screen edge.
+     *
+     * @param navBarView The bottom controls container view (FrameLayout / LinearLayout).
+     * @param isDark     Whether the current theme is dark.
+     */
+    public static void applyNavBarGlass(@NonNull View navBarView, boolean isDark) {
+        if (!IltixModuleManager.isThemeEnabled()) return;

+        float density = navBarView.getResources().getDisplayMetrics().density;
+        int marginPx  = Math.round(FLOATING_MARGIN_DP * density);
+        int bottomPx  = Math.round(NAV_BOTTOM_MARGIN_DP * density);

+        // Apply floating margins
+        ViewGroup.MarginLayoutParams lp =
+                (ViewGroup.MarginLayoutParams) navBarView.getLayoutParams();
+        if (lp != null) {
+            lp.leftMargin   = marginPx;
+            lp.rightMargin  = marginPx;
+            lp.bottomMargin = bottomPx;
+            navBarView.setLayoutParams(lp);
+        }

+        // Apply the Liquid Glass drawable
+        IltixLiquidGlassDrawable glassDrawable =
+                new IltixLiquidGlassDrawable(navBarView.getContext(), isDark);
+        navBarView.setBackground(glassDrawable);

+        // Apply RenderEffect blur on API 31+ for true frosted glass
+        if (Build.VERSION.SDK_INT >= 31) {
+            applyBackdropBlur(navBarView);
+        }

+        // Start the liquid animation when the view is attached
+        navBarView.addOnAttachStateChangeListener(new View.OnAttachStateChangeListener() {
+            @Override
+            public void onViewAttachedToWindow(@NonNull View v) {
+                glassDrawable.startAnimation();
+            }

+            @Override
+            public void onViewDetachedFromWindow(@NonNull View v) {
+                glassDrawable.stopAnimation();
+            }
+        });
+    }

+    @androidx.annotation.RequiresApi(31)
+    private static void applyBackdropBlur(@NonNull View view) {
+        // Use BlurMaskFilter via RenderEffect for true backdrop blur
+        android.graphics.RenderEffect blurEffect =
+                android.graphics.RenderEffect.createBlurEffect(
+                        20f, 20f,
+                        android.graphics.Shader.TileMode.MIRROR);
+        view.setRenderEffect(blurEffect);
+    }
+}
