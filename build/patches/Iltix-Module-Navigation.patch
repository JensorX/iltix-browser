+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Iltix Navigation Bar layout.
+  Added by Iltix-Module-Navigation.patch — DO NOT MODIFY upstream files.
+
+  Button order (left → right):
+    iltix_nav_back | iltix_nav_forward | iltix_nav_reload | iltix_nav_home
+    | iltix_nav_extensions | iltix_nav_tabs (+iltix_nav_tab_count) | iltix_nav_menu
+-->
+<org.chromium.chrome.browser.iltix.navigation.IltixNavBarView
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="56dp"
+    android:paddingStart="4dp"
+    android:paddingEnd="4dp"
+    android:gravity="center_vertical"
+    android:orientation="horizontal">
+
+    <!-- ← Back -->
+    <ImageButton
+        android:id="@+id/iltix_nav_back"
+        android:layout_width="0dp"
+        android:layout_height="match_parent"
+        android:layout_weight="1"
+        android:src="@drawable/ic_arrow_back_white_24dp"
+        android:background="?attr/selectableItemBackgroundBorderless"
+        android:contentDescription="@string/back"
+        android:padding="12dp" />
+
+    <!-- → Forward -->
+    <ImageButton
+        android:id="@+id/iltix_nav_forward"
+        android:layout_width="0dp"
+        android:layout_height="match_parent"
+        android:layout_weight="1"
+        android:src="@drawable/ic_arrow_forward_white_24dp"
+        android:background="?attr/selectableItemBackgroundBorderless"
+        android:contentDescription="@string/forward"
+        android:padding="12dp" />
+
+    <!-- ↻ Reload -->
+    <ImageButton
+        android:id="@+id/iltix_nav_reload"
+        android:layout_width="0dp"
+        android:layout_height="match_parent"
+        android:layout_weight="1"
+        android:src="@drawable/btn_toolbar_reload"
+        android:background="?attr/selectableItemBackgroundBorderless"
+        android:contentDescription="@string/accessibility_reload_page"
+        android:padding="12dp" />
+
+    <!-- 🏠 Home -->
+    <ImageButton
+        android:id="@+id/iltix_nav_home"
+        android:layout_width="0dp"
+        android:layout_height="match_parent"
+        android:layout_weight="1"
+        android:src="@drawable/btn_toolbar_home"
+        android:background="?attr/selectableItemBackgroundBorderless"
+        android:contentDescription="@string/accessibility_home"
+        android:padding="12dp" />
+
+    <!-- 🧩 Extensions (puzzle piece) -->
+    <ImageButton
+        android:id="@+id/iltix_nav_extensions"
+        android:layout_width="0dp"
+        android:layout_height="match_parent"
+        android:layout_weight="1"
+        android:src="@drawable/ic_extension_puzzle"
+        android:background="?attr/selectableItemBackgroundBorderless"
+        android:contentDescription="@string/accessibility_extensions"
+        android:padding="12dp" />
+
+    <!-- [N] Tabs — tab switcher button with count overlay -->
+    <FrameLayout
+        android:layout_width="0dp"
+        android:layout_height="match_parent"
+        android:layout_weight="1">
+
+        <!-- Uses the existing tab-switcher button drawable from Chromium -->
+        <ImageButton
+            android:id="@+id/iltix_nav_tabs"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:src="@drawable/btn_tabswitcher_modern"
+            android:background="?attr/selectableItemBackgroundBorderless"
+            android:contentDescription="@string/accessibility_tab_switcher_btn"
+            android:padding="12dp" />
+
+        <!-- Tab count badge (same number the stock tab-switcher button shows) -->
+        <TextView
+            android:id="@+id/iltix_nav_tab_count"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_gravity="center"
+            android:textSize="11sp"
+            android:textStyle="bold"
+            android:textColor="?attr/colorOnPrimary"
+            android:visibility="invisible" />
+    </FrameLayout>
+
+    <!-- ⋮ Menu (3-dot) -->
+    <ImageButton
+        android:id="@+id/iltix_nav_menu"
+        android:layout_width="0dp"
+        android:layout_height="match_parent"
+        android:layout_weight="1"
+        android:src="@drawable/ic_more_vert_24dp"
+        android:background="?attr/selectableItemBackgroundBorderless"
+        android:contentDescription="@string/accessibility_toolbar_btn_menu"
+        android:padding="12dp" />

+</org.chromium.chrome.browser.iltix.navigation.IltixNavBarView>
