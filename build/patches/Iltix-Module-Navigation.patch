+// Copyright 2026 The Iltix Authors. All rights reserved.
+// Use of this source code is governed by a GPL-2.0-or-later license.
+
+package org.chromium.chrome.browser.iltix.navigation;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.widget.LinearLayout;
+import android.widget.ImageButton;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import org.chromium.chrome.browser.iltix.theme.IltixThemeModule;
+import org.chromium.chrome.browser.iltix.IltixModuleManager;
+
+/**
+ * The Iltix Navigation bar view.
+ *
+ * A horizontal LinearLayout containing 7 navigation buttons.
+ * When the Iltix Theme module is also enabled, the Liquid Glass effect is
+ * applied to this view after attachment.
+ */
+public class IltixNavBarView extends LinearLayout {
+
+    public IltixNavBarView(@NonNull Context context) {
+        super(context);
+        init();
+    }
+
+    public IltixNavBarView(@NonNull Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        init();
+    }
+
+    public IltixNavBarView(@NonNull Context context, @Nullable AttributeSet attrs,
+            int defStyleAttr) {
+        super(context, attrs, defStyleAttr);
+        init();
+    }
+
+    private void init() {
+        setOrientation(HORIZONTAL);
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        // Apply Liquid Glass theme if that module is enabled
+        if (IltixModuleManager.isThemeEnabled()) {
+            boolean isDark = isDarkMode();
+            IltixThemeModule.applyNavBarGlass(this, isDark);
+        }
+    }
+
+    private boolean isDarkMode() {
+        int nightModeFlags = getResources().getConfiguration().uiMode
+                & android.content.res.Configuration.UI_MODE_NIGHT_MASK;
+        return nightModeFlags == android.content.res.Configuration.UI_MODE_NIGHT_YES;
+    }
+}
