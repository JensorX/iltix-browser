+package org.chromium.chrome.browser.iltix.navigation;
+
+import android.app.Activity;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageButton;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import org.chromium.base.supplier.ObservableSupplier;
+import org.chromium.chrome.browser.homepage.HomepageManager;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tabmodel.TabModelSelector;
+import org.chromium.chrome.browser.toolbar.menu_button.MenuButtonCoordinator;
+import org.chromium.chrome.browser.ui.appmenu.AppMenuHandler;
+import org.chromium.content_public.browser.LoadUrlParams;
+import org.chromium.chrome.browser.iltix.IltixModuleManager;
+import org.chromium.chrome.R;
+
+/**
+ * Coordinator for the Iltix navigation bar.
+ *
+ * Sets up all 7 navigation buttons and wires them to the appropriate
+ * Chromium APIs. The coordinator is instantiated by the bottom toolbar
+ * host if and only if {@link IltixModuleManager#isNavigationEnabled()}.
+ *
+ * Button order (left → right):
+ *   [0] Back       — navigates back in history (tablet-style arrow icon)
+ *   [1] Forward    — navigates forward in history
+ *   [2] Reload     — reloads the current page
+ *   [3] Home       — loads the configured homepage
+ *   [4] Extensions — opens the extension toolbar (existing Cromite action)
+ *   [5] Tabs       — opens the tab switcher, shows existing tab count badge
+ *   [6] Menu       — opens the 3-dot app menu
+ */
+public class IltixNavBarCoordinator {
+
+    private final Activity mActivity;
+    private final TabModelSelector mTabModelSelector;
+    private final AppMenuHandler mAppMenuHandler;
+    private final ObservableSupplier<Tab> mTabSupplier;
+    private IltixNavBarView mView;
+
+    public IltixNavBarCoordinator(
+            @NonNull Activity activity,
+            @NonNull TabModelSelector tabModelSelector,
+            @NonNull AppMenuHandler appMenuHandler,
+            @NonNull ObservableSupplier<Tab> tabSupplier) {
+        mActivity = activity;
+        mTabModelSelector = tabModelSelector;
+        mAppMenuHandler = appMenuHandler;
+        mTabSupplier = tabSupplier;
+    }
+
+    /**
+     * Inflates the Iltix nav bar into {@code parent} and wires all click handlers.
+     *
+     * @param parent          The ViewGroup to add the nav bar into.
+     * @param replaceExisting If true, all existing children of parent are removed first.
+     * @return the inflated IltixNavBarView, or null if the module is disabled.
+     */
+    @Nullable
+    public IltixNavBarView attach(@NonNull ViewGroup parent, boolean replaceExisting) {
+        if (!IltixModuleManager.isNavigationEnabled()) return null;
+
+        if (replaceExisting) parent.removeAllViews();
+
+        mView = (IltixNavBarView) LayoutInflater.from(mActivity)
+                .inflate(R.layout.iltix_nav_bar, parent, false);
+        parent.addView(mView);
+
+        wireButtons(mView);
+        return mView;
+    }
+
+    private void wireButtons(@NonNull IltixNavBarView view) {
+        // — Back —
+        ImageButton back = view.findViewById(R.id.iltix_nav_back);
+        back.setOnClickListener(v -> {
+            Tab tab = mTabSupplier.get();
+            if (tab != null && tab.canGoBack()) tab.goBack();
+        });
+        back.setOnLongClickListener(v -> {
+            // Long press: show back-history list (same as long-press on back in tablet mode)
+            // We delegate to the standard Android back-press which Chromium handles:
+            mActivity.onBackPressed();
+            return true;
+        });
+
+        // — Forward —
+        ImageButton forward = view.findViewById(R.id.iltix_nav_forward);
+        forward.setOnClickListener(v -> {
+            Tab tab = mTabSupplier.get();
+            if (tab != null && tab.canGoForward()) tab.goForward();
+        });
+
+        // — Reload —
+        ImageButton reload = view.findViewById(R.id.iltix_nav_reload);
+        reload.setOnClickListener(v -> {
+            Tab tab = mTabSupplier.get();
+            if (tab != null) tab.reload();
+        });
+        reload.setOnLongClickListener(v -> {
+            // Long-press → hard reload (bypass cache) like desktop Ctrl+Shift+R
+            Tab tab = mTabSupplier.get();
+            if (tab != null) tab.reloadIgnoringCache();
+            return true;
+        });
+
+        // — Home —
+        ImageButton home = view.findViewById(R.id.iltix_nav_home);
+        home.setOnClickListener(v -> {
+            Tab tab = mTabSupplier.get();
+            if (tab == null) return;
+            String homepageUrl = HomepageManager.getHomepageUri();
+            if (homepageUrl != null && !homepageUrl.isEmpty()) {
+                tab.loadUrl(new LoadUrlParams(homepageUrl));
+            }
+        });
+
+        // — Extensions —
+        // The Extensions button uses the existing Cromite extension toolbar mechanism.
+        // We fire the same action as the extension puzzle-piece icon in the toolbar.
+        ImageButton extensions = view.findViewById(R.id.iltix_nav_extensions);
+        extensions.setOnClickListener(v -> {
+            // The extension toolbar button action is surfaced via the app menu
+            // in a standard Chromite build; open the Extensions menu item.
+            mAppMenuHandler.showAppMenu(v, true);
+        });

+        // — Tabs —
+        ImageButton tabs = view.findViewById(R.id.iltix_nav_tabs);
+        TextView tabCount = view.findViewById(R.id.iltix_nav_tab_count);
+        tabs.setOnClickListener(v -> {
+            // Switch to tab switcher — Chromium routes this via the toolbar tab switcher button
+            // We call the standard tab-switcher show action through the activity.
+            if (mActivity instanceof org.chromium.chrome.browser.ChromeTabbedActivity) {
+                ((org.chromium.chrome.browser.ChromeTabbedActivity) mActivity)
+                        .getLayoutManager().showLayout(
+                                org.chromium.chrome.browser.layouts.LayoutType.TAB_SWITCHER,
+                                true);
+            }
+        });
+        // Observe tab count changes and update the badge TextView
+        mTabModelSelector.getCurrentTabModelSupplier().addObserver(model -> updateTabCount(tabCount));
+        updateTabCount(tabCount);

+        // — Menu (3-dot) —
+        ImageButton menu = view.findViewById(R.id.iltix_nav_menu);
+        menu.setOnClickListener(v -> mAppMenuHandler.showAppMenu(v, false));
+    }

+    private void updateTabCount(@NonNull TextView tabCount) {
+        int count = mTabModelSelector.getTotalTabCount();
+        tabCount.setText(count > 99 ? ":D" : String.valueOf(count));
+        tabCount.setVisibility(count > 0 ? View.VISIBLE : View.INVISIBLE);
+    }

+    public void destroy() {
+        if (mView != null) {
+            mView = null;
+        }
+    }
+}
